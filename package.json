{
  "name": "kahraba-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diagnostic des factures d'électricité des entreprises au Maroc.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
